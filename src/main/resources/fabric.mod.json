{
  "schemaVersion": 1,
  "id": "chibify",
  "version": "${version}",
  "name": "Chibify",
  "description": "Renders players with chibi proportions, adjusted hitboxes, eye height, and aligned elytra.",
  "authors": [
    "Chibify Contributors"
  ],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "net.chibify.chibify.Chibify"
    ],
    "client": [
      "net.chibify.chibify.client.ChibifyClient"
    ],
    "modmenu": [
      "net.chibify.chibify.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "chibify.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
